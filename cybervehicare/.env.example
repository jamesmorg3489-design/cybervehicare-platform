# ============================================================
# CyberVehicare Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=vehicle_health
POSTGRES_USER=cvuser
POSTGRES_PASSWORD=cvpass

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min32chars

# ── Service Ports (internal, change only if conflict) ─────────
GATEWAY_PORT=8000
TELEMETRY_PORT=8001
DIAGNOSTICS_PORT=8002
PREDICTION_PORT=8003
ALERT_PORT=8004
DASHBOARD_PORT=8501
MONOLITH_PORT=9000
PROMETHEUS_PORT=9090

# ── Simulator Settings ────────────────────────────────────────
RECORDS_PER_BATCH=50
INTERVAL_SECONDS=2
