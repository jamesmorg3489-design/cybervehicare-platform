{
  "name": "CyberVehicare",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [8000, 8001, 8002, 8003, 8004, 8501, 9000, 9090, 5432],
  "portsAttributes": {
    "8000": { "label": "API Gateway" },
    "8001": { "label": "Telemetry Service" },
    "8002": { "label": "Diagnostics Service" },
    "8003": { "label": "Prediction Service" },
    "8004": { "label": "Alert Service" },
    "8501": { "label": "Dashboard" },
    "9000": { "label": "Monolith" },
    "9090": { "label": "Prometheus" }
  },
  "postCreateCommand": "pip install -r ml/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-python.flake8"
      ]
    }
  }
}
